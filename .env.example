# =============================================
# Database (SQLite - Local)
# =============================================
# SQLite는 로컬 파일로 저장됩니다 (prisma/dev.db)
# 별도 설정 불필요 - Prisma가 자동으로 관리합니다

# =============================================
# NextAuth
# =============================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-min-32-chars-here"

# =============================================
# OAuth Providers
# =============================================

# Google Cloud Console: https://console.cloud.google.com/
# APIs & Services > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Kakao Developers: https://developers.kakao.com/
# 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""

# Naver Developers: https://developers.naver.com/
# 내 애플리케이션 > CLIEN ID / Client Secret
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""

# GitHub OAuth Apps: https://github.com/settings/developers
# OAuth Apps > New OAuth App
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# =============================================
# Storage (Supabase)
# =============================================
# https://supabase.com > Storage > New bucket
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
