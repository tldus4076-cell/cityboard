// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// =============================================
// User & Auth
// =============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?   // hashed, null for social login
  nickname      String    @unique
  profileImage  String?
  role          String    @default("USER") // USER | ADMIN
  isBlocked     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts        Account[]
  sessions        Session[]
  posts           Post[]
  comments        Comment[]
  likes           Like[]
  bookmarks       Bookmark[]
  reports         Report[]
  blockedBy       UserBlock[] @relation("BlockedUser")
  blockedUsers    UserBlock[] @relation("BlockedBy")
  uploads         File[]
  adminActions    AdminAction[]
  anonymousPosts  Post[] @relation("AnonymousAuthor")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =============================================
// Board & Post
// =============================================

// BoardType: FREE | NOTICE | QNA | RESOURCE
model Board {
  id          String   @id @default(cuid())
  type        String   @unique // FREE, NOTICE, QNA, RESOURCE
  name        String
  description String?
  createdAt   DateTime @default(now())

  posts Post[]
}

model Post {
  id          String    @id @default(cuid())
  title       String
  content     String
  boardType   String    // FREE, NOTICE, QNA, RESOURCE
  postType    String    @default("NORMAL") // NORMAL, NOTICE, SECRET, ANONYMOUS
  authorId    String
  isHidden    Boolean   @default(false)
  hiddenAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  anonymousAuthorId String?
  anonymousAuthor   User?   @relation("AnonymousAuthor", fields: [anonymousAuthorId], references: [id])

  author    User      @relation(fields: [authorId], references: [id])
  board     Board     @relation(fields: [boardType], references: [type])
  comments  Comment[]
  likes     Like[]
  bookmarks Bookmark[]
  reports   Report[]
  files     File[]
}

// =============================================
// Comment
// =============================================

model Comment {
  id        String    @id @default(cuid())
  content   String
  authorId  String
  postId    String
  parentId  String?
  isHidden  Boolean   @default(false)
  isAnonymous Boolean @default(false)
  anonymousAuthorId String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  author  User      @relation(fields: [authorId], references: [id])
  post    Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")
  likes   Like[]
  reports Report[]
}

// =============================================
// Like
// =============================================

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String?
  commentId String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id])
  post    Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
}

// =============================================
// Bookmark
// =============================================

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

// =============================================
// Report
// =============================================

// ReportReason: ABUSE | SPAM | INAPPROPRIATE | PERSONAL_INFO | OTHER
// ReportStatus: PENDING | RESOLVED | REJECTED
model Report {
  id         String    @id @default(cuid())
  reporterId String
  postId     String?
  commentId  String?
  reason     String    // ABUSE, SPAM, INAPPROPRIATE, PERSONAL_INFO, OTHER
  status     String    @default("PENDING") // PENDING, RESOLVED, REJECTED
  memo       String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  reporter User     @relation(fields: [reporterId], references: [id])
  post     Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment  Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([reporterId, postId])
  @@unique([reporterId, commentId])
}

// =============================================
// File Upload
// =============================================

model File {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  uploaderId   String
  postId       String?
  createdAt    DateTime @default(now())

  uploader User   @relation(fields: [uploaderId], references: [id])
  post     Post?  @relation(fields: [postId], references: [id], onDelete: SetNull)
}

// =============================================
// User Block (관리자의 회원 차단)
// =============================================

model UserBlock {
  id          String   @id @default(cuid())
  blockedId   String
  blockedById String
  reason      String?
  createdAt   DateTime @default(now())

  blocked   User @relation("BlockedUser", fields: [blockedId], references: [id])
  blockedBy User @relation("BlockedBy", fields: [blockedById], references: [id])

  @@unique([blockedId, blockedById])
}

// =============================================
// Admin Action Audit Log
// =============================================

// AdminActionType: DELETE_POST | RESTORE_POST | HIDE_POST | UNHIDE_POST | BLOCK_USER | UNBLOCK_USER | DELETE_COMMENT | REVEAL_ANONYMOUS_AUTHOR | PROCESS_REPORT
model AdminAction {
  id         String   @id @default(cuid())
  adminId    String
  action     String   // DELETE_POST, RESTORE_POST, HIDE_POST, UNHIDE_POST, BLOCK_USER, UNBLOCK_USER, DELETE_COMMENT, REVEAL_ANONYMOUS_AUTHOR, PROCESS_REPORT
  targetType String?
  targetId   String?
  memo       String?
  createdAt  DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])
}
